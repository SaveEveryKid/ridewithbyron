# ---- Required in production
NODE_ENV=production
SITE_URL=https://www.ridewithbyron.com
SESSION_SECRET=           # long random string: openssl rand -base64 48
ADMIN_PASSWORD_HASH=      # npm run hash-password -- "a strong password"
PORT=3000
# DB_PATH=/var/lib/ridewithbyron/rwb.sqlite   # put on a persistent disk

# ---- Inventory sync (defaults are the verified values; see docs/INVENTORY-SOURCE.md)
# SOURCE_BASE_URL=https://www.shoalsoutdoorsportsflorence.com
# SOURCE_FLORENCE_NAME=Shoals Outdoor Sports - Florence
# SOURCE_FLORENCE_DEALERSHIP_ID=12a621fc-062f-42aa-ae9d-b00b0115f412
# SYNC_INTERVAL_MINUTES=45
# SYNC_REQUEST_DELAY_MS=10000
# SYNC_ENABLED=true

# ---- Torque CRM (leads are queued locally until this is set)
TORQUE_WEBHOOK_URL=
TORQUE_API_KEY=
TORQUE_SIGNING_SECRET=
TORQUE_ASSIGNEE=Byron Green
NOTIFY_WEBHOOK_URL=       # optional instant alert relay (JSON POST with a "text" field)

# ---- Measurement (load only after visitor consent)
GA4_MEASUREMENT_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_LEAD_LABEL=
META_PIXEL_ID=
